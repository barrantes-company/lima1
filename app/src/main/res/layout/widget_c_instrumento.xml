<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/hour"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:fontFamily="@font/manrope_time"
            android:fontFeatureSettings="tnum"
            android:format12Hour="h"
            android:format24Hour="H"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/ink"
            android:textSize="52sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/dot" />

            <ImageView
                android:id="@+id/dot2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@null"
                android:src="@drawable/dot" />
        </LinearLayout>

        <TextClock
            android:id="@+id/minute"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:fontFamily="@font/manrope_time"
            android:fontFeatureSettings="tnum"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/minute"
            android:textSize="28sp" />

        <TextView android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:text="—°"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/day"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="40"
        android:progressDrawable="@drawable/day_bar" />

    <TextView
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/manrope"
        android:maxLines="1"
        android:textColor="@color/date"
        android:textSize="13sp" />
</LinearLayout>
